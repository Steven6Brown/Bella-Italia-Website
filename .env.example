# Copy to .env.local for local work. Never commit real values.
NEXT_PUBLIC_SITE_URL=https://example.com
# Set to "true" only when the site is ready for Google to index it.
NEXT_PUBLIC_ALLOW_INDEXING=false
# Optional. Plausible analytics domain, for example example.com. Leave empty for no analytics.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Contact form email (Resend). The form reports "not set up" until all three are filled in.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
